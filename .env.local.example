# Copy this to .env.local and fill in your values.
# .env.local is gitignored and never committed.
#
# These are sourced by scripts/on-event.sh before the hook binary runs.
# For --plugin-dir local testing where Claude Code's userConfig prompts
# are not triggered.

OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-fiddler-endpoint>
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <your-token>,fiddler-application-id=<your-app-id>"
OTEL_RESOURCE_ATTRIBUTES="application.id=<your-app-id>"

# Binary source selector (default: release).
#
#   release  Download the released binary from GitHub Releases via gh.
#
#   local    Use only a locally built binary (make build).
#            Set this when developing the plugin and testing your own changes.
#
# FIDDLER_BINARY_SOURCE=local
