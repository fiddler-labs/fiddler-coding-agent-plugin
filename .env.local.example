# Local development only. Copy this to .env.local and fill in your values.
# .env.local is gitignored and never committed.
#
# The plugin never reads this file. Run `make dev` to start Claude Code with
# these values exported, so the hooks inherit them the same way they inherit
# userConfig values from an installed plugin.

CLAUDE_PLUGIN_OPTION_OTLP_URL="https://<your-fiddler-endpoint>"
# Bare token value. Do not add a "Bearer " prefix.
CLAUDE_PLUGIN_OPTION_AUTH_TOKEN="<your-token>"
CLAUDE_PLUGIN_OPTION_APP_ID="<your-app-id>"

# Binary source selector (default: release).
#
#   release  Download the released binary from the public GitHub Release.
#
#   local    Use only a locally built binary (make build).
#            Set this when developing the plugin and testing your own changes.
#
# FIDDLER_BINARY_SOURCE=local
